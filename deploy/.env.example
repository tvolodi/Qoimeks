# Copy to deploy/.env on the host (chmod 600). Never commit the real file.

# Letters and digits only: it is placed inside a database URL.
POSTGRES_PASSWORD=

# Shared secret every app must send. Generate with: openssl rand -hex 32
ACCESS_TOKEN=

# Separate secret for the administration page (/admin/). Generate the same way.
# Leave empty to keep the page's actions closed.
ADMIN_TOKEN=

# Speech to text.
ELEVENLABS_API_KEY=

# Language model: set the key of one provider (anthropic, openai, xai, deepseek, minimax).
# LLM_PROVIDER and LLM_MODEL are optional overrides.
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#XAI_API_KEY=
#DEEPSEEK_API_KEY=
#MINIMAX_API_KEY=
#LLM_PROVIDER=
#LLM_MODEL=

# Loopback port nginx proxies to.
HOST_PORT=3113
